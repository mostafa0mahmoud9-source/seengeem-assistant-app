{
  "name": "seengeem-assistant",
  "version": "1.1.1",
  "private": true,
  "description": "SeenGeem Assistant desktop and Android clients",
  "author": "SeenGeem",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.seengeem.assistant",
    "productName": "SeenGeem Assistant",
    "artifactName": "SeenGeem-Assistant-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "mostafa0mahmoud9-source",
        "repo": "seengeem-assistant-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "3073"
    }
  }
}